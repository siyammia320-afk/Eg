def acquire_checked_number(rid):
    """
    Fetch a number from the panel and run the GraphQL checker.
    Skips numbers already used. Returns (full_number, status, desc) or (None, None, None).
    """
    fallback = None
    for attempt in range(1, MAX_NUM_ATTEMPTS + 1):
        print(f"  {W}[{G}•{W}] Fetching number... attempt {attempt}/{MAX_NUM_ATTEMPTS}{W}")
        nd = fetch_live_number(rid)
        if not nd:
            time.sleep(1.2)
            continue
        full_number = str(nd.get("full_number", "")).strip().lstrip("+")
        if not full_number or full_number in PANEL_USED:
            time.sleep(1.0)
            continue

        try:
            status, desc = check_number_graphql(f"+{full_number}")
        except Exception:
            status, desc = "error", "checker exception"

        if status == "free":
            PANEL_USED.add(full_number)
            print(f"  {G}✔ +{full_number} [FREE] — using this number{W}")
            return full_number, status, desc

        if status == "taken":
            print(f"  {R}✖ +{full_number} [TAKEN: {desc[:40]}] — skipping{W}")
            PANEL_USED.add(full_number)
            time.sleep(0.6)
            continue

        print(f"  {W}▲ +{full_number} [{status.upper()}] — keeping as fallback{W}")
        if fallback is None:
            fallback = (full_number, status, desc)
        time.sleep(0.6)

    if fallback:
        PANEL_USED.add(fallback[0])
        print(f"  {W}➜ Using fallback number +{fallback[0]} [{fallback[1]}]{W}")
        return fallback
    return None, None, None

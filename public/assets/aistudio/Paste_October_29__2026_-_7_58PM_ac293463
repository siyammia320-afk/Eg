def _gen_datr():
    """Generate a Facebook-style datr cookie value (~24 chars)."""
    chars = string.ascii_letters + string.digits + "_-"
    return "".join(random.choice(chars) for _ in range(24))


def _extract_fb_tokens(html):
    tokens = {}
    try:
        soup = BeautifulSoup(html, "html.parser")
        for inp in soup.find_all("input"):
            name = inp.get("name")
            value = inp.get("value")
            if name and value is not None and value != "":
                tokens[name] = value
    except Exception:
        pass

    def grab(key, *patterns):
        if tokens.get(key):
            return
        for p in patterns:
            try:
                m = re.search(p, html)
                if m and m.group(1):
                    tokens[key] = m.group(1)
                    return
            except Exception:
                continue

    grab("lsd",
         r'"LSD",\[\],\{"token":"([^"]+)"',
         r'"lsd"\s*:\s*"([^"]+)"',
         r'name="lsd"[^>]*value="([^"]+)"')
    grab("fb_dtsg",
         r'"DTSGInitialData",\[\],\{"token":"([^"]+)"',
         r'"fb_dtsg"\s*:\s*"([^"]+)"',
         r'name="fb_dtsg"[^>]*value="([^"]+)"')
    grab("jazoest",
         r'"jazoest"\s*:\s*"(\d+)"',
         r'jazoest=(\d+)',
         r'name="jazoest"[^>]*value="(\d+)"')
    grab("__dyn",
         r'"__dyn"\s*:\s*"([^"]+)"',
         r'name="__dyn"[^>]*value="([^"]+)"')
    grab("__a",
         r'name="__a"[^>]*value="([^"]+)"',
         r'"__a"\s*:\s*"([^"]+)"')
    grab("__csr",
         r'name="__csr"[^>]*value="([^"]*)"',
         r'"__csr"\s*:\s*"([^"]*)"')
    grab("reg_instance", r'name="reg_instance"[^>]*value="([^"]+)"')
    grab("reg_impression_id", r'name="reg_impression_id"[^>]*value="([^"]+)"')
    grab("logger_id", r'name="logger_id"[^>]*value="([^"]+)"')
    return tokens


